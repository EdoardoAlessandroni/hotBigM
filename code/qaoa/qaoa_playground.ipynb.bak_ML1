    "#             coeffs.append(-val / 4);  obs.append(qml.PauliZ(pair[0]))\n",
    "#             coeffs.append(-val / 4);  obs.append(qml.PauliZ(pair[1]))\n",
    "#     cost_h  = qml.simplify(qml.dot(coeffs, obs))\n",
    "#     mixer_h = qaoa.x_mixer(range(num_qubits))\n",
    "\n",
    "#     # ── 2. Device / QNodes (unchanged) ──────────────────────────────────────\n",
