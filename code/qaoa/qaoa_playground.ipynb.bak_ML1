    "eta[:, 0] = eta_ext[:,0]\n",
    "\n",
    "file = open(\"./data_qaoa/test1_TSP_full.txt\", \"wb\")\n",
    "pickle.dump(eta, file)\n",
    "file.close()"
   ]
