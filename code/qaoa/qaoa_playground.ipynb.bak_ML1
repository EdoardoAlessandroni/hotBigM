    "#             counts = (res.to_pytket().get_counts() if hasattr(res, \"to_pytket\")\n",
    "#                       else res.get_counts())\n",
    "#             if use_cache and status.status == JobStatusEnum.COMPLETED:\n",
    "#                 with open(cache_file, \"wb\") as f:\n",
    "#                     pickle.dump(counts, f)\n",
